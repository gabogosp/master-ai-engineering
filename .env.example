# Proveedor de LLM: openai | anthropic
LLM_PROVIDER=
# Modelo a utilizar (gpt-4o-mini para openai, claude-haiku-4-5 para anthropic)
LLM_MODEL=

# API keys (solo se necesita la del proveedor elegido)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Entorno de ejecución y nivel de logging
APP_ENV=
LOG_LEVEL=

# Cache exact-match (Redis). Si se dejan vacías, usa localhost:6379 y 24h de TTL.
# Levantar Redis con: docker compose up -d redis
REDIS_URL=
CACHE_TTL_SECONDS=

# URL del servicio IA (FastAPI) que consume el cliente Streamlit.
# Si se deja vacía, usa http://localhost:8000.
BACKEND_URL=

# Ventana deslizante del historial conversacional (turnos user+assistant).
# Si se deja vacía, usa 6.
MAX_CONVERSATION_TURNS=
